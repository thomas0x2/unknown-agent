# Copy to .env and fill in to enable Jev (TypeSafe System One). Without it, the game runs on the
# offline keyword router. The key is read only by the backend proxy (server/jev-proxy.mjs); it never
# ships in the client.
TYPESAFE_API_KEY=
# Optional: override the TypeSafe base URL.
# TYPESAFE_BASE_URL=
# Optional: proxy port (defaults to 8787; the Vite dev server proxies /api here).
# PORT=8787
