{
  "id": "restaurant",
  "name": "Restaurant site",
  "pages": [
    {
      "id": "landing",
      "title": "Home"
    },
    {
      "id": "menu",
      "title": "Menu"
    },
    {
      "id": "booking",
      "title": "Book a table"
    }
  ],
  "features": [
    {
      "id": "landing",
      "description": "a landing page with the restaurant name and opening hours",
      "pageId": "landing",
      "failures": [
        "visible",
        "subtle"
      ],
      "bugs": [
        {
          "id": "hours_wrong",
          "when": "opening hours {{hours}}",
          "match": "\\bhours\\b|\\bopen(s|ing)? (at|from|until|till|daily|times?)\\b|\\bclos(e|es|ing) (at|times?)\\b|\\bwrong times?\\b|\\d{1,2}(:\\d\\d)?\\s*(-|–|to|until|till)\\s*\\d{1,2}"
        },
        {
          "id": "name_wrong",
          "when": "restaurant name {{name}}",
          "match": "\\b(restaurant|site'?s?|website'?s?|wrong|correct|right|the|its|his) name\\b|\\bname\\b[^.?!]{0,20}\\b(wrong|misspel\\w*|typo|incorrect|spelled)\\b|\\b(misspel\\w*|typo)\\b|(show|say|display|read)s?\\b[^.?!]{0,30}{{name}}|{{name}}[^.?!]{0,20}\\b(not|instead)\\b"
        }
      ],
      "checklist": [
        {
          "id": "name",
          "text": "{{name}}",
          "bug": "name_wrong"
        },
        {
          "id": "hours",
          "text": "{{hours}}",
          "bug": "hours_wrong"
        }
      ],
      "match": "\\b(landing( page)?|home ?page|front ?page|main page|start page|opening hours|restaurant name)\\b"
    },
    {
      "id": "menu",
      "description": "a menu page listing each dish with its price in DOLR",
      "pageId": "menu",
      "failures": [
        "subtle",
        "failed_fetch"
      ],
      "details": [
        "dishes"
      ],
      "firstBuildBug": true,
      "bugs": [
        {
          "id": "prices_missing",
          "when": "prices missing next to the dishes",
          "match": "\\b(no|missing|without|lacks?|lacking|add|show|forgot|forgotten)\\b[^.?!]{0,20}\\bprices?\\b|\\bprices?\\b[^.?!]{0,20}\\b(missing|gone|empty|blank|absent|not (shown|there|listed|showing|visible)|aren'?t (shown|there|listed|showing|visible)|disappeared)\\b"
        },
        {
          "id": "prices_curo",
          "when": "prices in DOLR, not CURO",
          "match": "\\b(curo|currency|currencies)\\b|\\bin dolr\\b|\\bdolr\\b[^.?!]{0,20}\\b(not|instead)\\b|\\bnot dolr\\b"
        },
        {
          "id": "wrong_items",
          "when": "dishes or items missing, renamed or invented",
          "orDetails": true,
          "match": "\\b(missing|wrong|invented|made[ -]up|extra|renamed|misspel\\w*|unknown|fake|doesn'?t exist)\\b[^.?!]{0,20}\\b(dish(es)?|items?|pizzas?|food)\\b|\\b(dish(es)?|items?|pizzas?)\\b[^.?!]{0,25}\\b(missing|wrong|invented|made up|renamed|not on|isn'?t on|shouldn'?t be|doesn'?t exist|don'?t exist)\\b|\\b({{dishes:words}})\\b|\\bstill\\b[^.?!]{0,25}\\b(on|listed|there|shown)\\b|\\b(never|didn'?t|did not|not)\\s+(ask(ed)?|order(ed)?|want(ed)?)\\b|\\b(doesn'?t|don'?t) belong\\b|\\bshouldn'?t be (there|on)\\b"
        }
      ],
      "checklist": [
        {
          "id": "dishes",
          "text": "{{dishes}}",
          "bug": "hallucinated"
        },
        {
          "id": "currency",
          "text": "DOLR",
          "bug": "prices_curo"
        }
      ],
      "match": "\\b(menu|dish(es)?|prices?|pizzas?)\\b"
    },
    {
      "id": "booking",
      "description": "a table booking form that emails the guest a confirmation",
      "pageId": "booking",
      "failures": [
        "deep",
        "subtle",
        "visible"
      ],
      "deep": true,
      "match": "\\b(booking( form)?|book a table|reservations?|reserve a table)\\b"
    },
    {
      "id": "doordish",
      "description": "a DoorDish listing with the same menu, hours and address",
      "failures": [
        "subtle",
        "failed_fetch"
      ],
      "match": "\\bdoor ?dish\\b"
    }
  ]
}
